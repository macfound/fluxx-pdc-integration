            "text": "{% assign sorted_fields = model.SortMappedFieldsbyFieldPosition %}\n{% assign mapping_warnings = model.Mapped_Field_Warnings %}\n\n<table class=\"pdc-mapped-fields\">\n  <colgroup>\n    <col class=\"col-content\">\n    <col class=\"col-actions\">\n  </colgroup>\n  <tbody>\n    {% if sorted_fields.size > 0 %}\n      {% for field in sorted_fields %}\n        {% assign is_complete = true %}\n        {% unless field.pdc_field_position and field.fluxx_field and field.pdc_field and field.pdc_application_field_instructions %}\n          {% assign is_complete = false %}\n        {% endunless %}\n        \n        <tr class=\"field-row\">\n          <td class=\"content-cell\">\n            <table class=\"inner-table\">\n              <tr class=\"main-row\">\n                <td class=\"position\">\n                  {% if field.pdc_field_position %}\n                    <strong>{{ field.pdc_field_position }}</strong>\n                  {% else %}\n                    <span class=\"empty\">—</span>\n                  {% endif %}\n                </td>\n                <td class=\"status\">\n                  {% if is_complete %}\n                    <span class=\"complete\">✓</span>\n                  {% else %}\n                    <span class=\"incomplete\">⚠</span>\n                  {% endif %}\n                </td>\n                <td class=\"instructions-preview\">\n                  <div class=\"instructions-label\">Instructions</div>\n                  <div class=\"instructions-text\">\n                    {% if field.pdc_application_field_instructions %}\n                      {% if field.pdc_application_field_instructions.size > 250 %}\n                        {{ field.pdc_application_field_instructions | truncate: 250, \"...\" }}\n                      {% else %}\n                        {{ field.pdc_application_field_instructions }}\n                      {% endif %}\n                    {% else %}\n                      <em>No instructions provided</em>\n                    {% endif %}\n                  </div>\n                </td>\n              </tr>\n              <tr class=\"detail-row\">\n                <td colspan=\"3\">\n                  <div class=\"field-details\">\n                    <div class=\"field-item\">\n                      <span class=\"field-label\">Fluxx Field:</span>\n                      {% if field.fluxx_field %}\n                        <span class=\"field-value\">{{ field.fluxx_field }}</span>\n                      {% else %}\n                        <span class=\"field-value empty\">Not mapped</span>\n                      {% endif %}\n                    </div>\n                    <div class=\"field-item\">\n                      <span class=\"field-label\">PDC Field:</span>\n                      {% if field.pdc_field %}\n                        <span class=\"field-value\">{{ field.pdc_field }}</span>\n                      {% else %}\n                        <span class=\"field-value empty\">Not set</span>\n                      {% endif %}\n                    </div>\n                    {% assign warning_key = field.id | append: '' %}\n                    {% assign field_warning = mapping_warnings[warning_key] %}\n                    {% if field_warning %}<div class=\"field-warning\">&#9888; {{ field_warning | escape }}</div>{% endif %}\n                  </div>\n                </td>\n              </tr>\n            </table>\n          </td>\n          <td class=\"actions\">\n            <a href=\"/machine_models/{{ field.id }}\" \n               class=\"new-detail  action-btn view\"\n               title=\"View\" \n               data-insert=\"after\">View</a>\n          </td>\n        </tr>\n      {% endfor %}\n    {% else %}\n      <tr>\n        <td class=\"no-data\" colspan=\"2\">No mapped fields found</td>\n      </tr>\n    {% endif %}\n  </tbody>\n</table>\n\n<style>\n  /* Outer table */\n  .pdc-mapped-fields {\n    width: 100%;\n    max-width: 493px;\n    border-collapse: collapse;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    table-layout: fixed;\n  }\n  \n  /* Column definitions */\n  .pdc-mapped-fields .col-content {\n    width: calc(100% - 50px);\n  }\n  \n  .pdc-mapped-fields .col-actions {\n    width: 50px;\n  }\n  \n  /* Outer table cells */\n  .pdc-mapped-fields .field-row {\n    border-top: 2px solid #d0d0d0;\n    border-bottom: 2px solid #d0d0d0;\n  }\n  \n  .pdc-mapped-fields .content-cell {\n    vertical-align: top;\n    padding-top: 12px;\n  }\n  \n  /* Inner table */\n  .pdc-mapped-fields .inner-table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n  \n  /* Main row styling */\n  .pdc-mapped-fields .main-row {\n    background: #f0f4f8;\n  }\n  \n  .pdc-mapped-fields .main-row td {\n    padding-right: 6px;\n    padding-left: 6px;\n    vertical-align: top;\n    padding-top: 8px;\n    margin-top: 8px;\n  }\n  \n  /* Position column */\n  .pdc-mapped-fields .position {\n    width: 30px;\n    text-align: center;\n    font-size: 16px;\n    font-weight: bold;\n    color: #2c3e50;\n  }\n  \n  .pdc-mapped-fields .position .empty {\n    color: #ccc;\n    font-weight: normal;\n  }\n  \n  /* Status column */\n  .pdc-mapped-fields .status {\n    width: 30px;\n    text-align: center;\n    font-size: 16px;\n  }\n  \n  .pdc-mapped-fields .status .complete {\n    color: #28a745;\n  }\n  \n  .pdc-mapped-fields .status .incomplete {\n    color: #ffc107;\n  }\n  \n  /* Instructions column */\n  .pdc-mapped-fields .instructions-preview {\n    padding-left: 8px;\n    padding-right: 8px;\n  }\n  \n  .pdc-mapped-fields .instructions-label {\n    font-size: 10px;\n    text-transform: uppercase;\n    color: #666;\n    margin-bottom: 2px;\n    font-weight: 600;\n  }\n  \n  .pdc-mapped-fields .instructions-text {\n    font-size: 12px;\n    color: #495057;\n    line-height: 1.3;\n    word-wrap: break-word;\n  }\n  \n  .pdc-mapped-fields .instructions-text em {\n    color: #999;\n    font-style: italic;\n  }\n  \n  /* Detail row styling */\n  .pdc-mapped-fields .detail-row {\n    background: white;\n  }\n  \n  .pdc-mapped-fields .field-details {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n    padding-left: 12px;\n    padding-right: 12px;\n  }\n  \n  .pdc-mapped-fields .field-item {\n    display: flex;\n    align-items: baseline;\n  }\n  \n  .pdc-mapped-fields .field-label {\n    font-weight: 600;\n    color: #495057;\n    margin-right: 6px;\n    font-size: 11px;\n    min-width: 70px;\n  }\n  \n  .pdc-mapped-fields .field-value {\n    color: #212529;\n    font-size: 12px;\n    word-break: break-word;\n  }\n  \n  .pdc-mapped-fields .field-warning {\n    margin-top: 6px;\n    padding: 6px 8px;\n    background: #fff8e1;\n    border-left: 3px solid #f0ad4e;\n    color: #6d4c00;\n    font-size: 12px;\n  }\n\n  .pdc-mapped-fields .field-value.empty {\n    color: #999;\n    font-style: italic;\n  }\n  \n  /* Actions column */\n  .pdc-mapped-fields .actions {\n    padding-left: 2px;\n    padding-right: 2px;\n    vertical-align: top;\n    border-left: 1px solid #d0d0d0;\n  }\n  \n  .pdc-mapped-fields .action-btn {\n    display: block;\n    padding: 3px 4px;\n    margin-bottom: 2px;\n    border-radius: 2px;\n    text-decoration: none;\n    font-size: 11px;\n    font-weight: 500;\n    text-align: center;\n    transition: opacity 0.2s;\n  }\n  \n  .pdc-mapped-fields .action-btn:first-child {\n    margin-top: 8px; /* Match the padding of main-row td */\n  }\n  \n  .pdc-mapped-fields .action-btn.view {\n    background: #17a2b8;\n    color: white;\n  }\n  \n  .pdc-mapped-fields .action-btn.edit {\n    background: #6c757d;\n    color: white;\n  }\n  \n  .pdc-mapped-fields .action-btn.delete {\n    background: #dc3545;\n    color: white;\n  }\n  \n  .pdc-mapped-fields .action-btn:hover {\n    opacity: 0.8;\n  }\n  \n  /* No data styling */\n  .pdc-mapped-fields .no-data {\n    text-align: center;\n    padding: 40px;\n    color: #666;\n    font-size: 14px;\n  }\n</style>"
