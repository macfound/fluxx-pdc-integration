        "allow_script": "1",
        "text": "<img style=\"display:none\" src=\"/images/fluxx_engine/theme/default/icons/sitemap.png\" onload=\"function filterApplicationDropdown(inputObj) {\n    var base64Data = '{{ model.List_Opportunities_to_JSON }}';\n    var jsonData = atob(base64Data);\n    var data = JSON.parse(jsonData);\n\n    var detailContainer = $(inputObj).closest('.detail.area')[0]\n    var dropdown = $(detailContainer).find('select[id=machine_model_application]')[0];\n    if (!dropdown) return;\n\n    // Get the opportunity id which matches the currently selected opportunity\n    var opportunityDropdown = $(detailContainer).find('select[id=machine_model_opportunity]')[0];\n    if (!opportunityDropdown) return;\n    var selectedOption = opportunityDropdown.options[opportunityDropdown.selectedIndex];\n    var selectedText = (selectedOption.textContent || selectedOption.innerText).trim();\n    var opportunityOption = data.find(item =&gt; item.model_attribute_value.description.trim() == selectedText);\n\n    if (!opportunityOption || !opportunityOption.model_attribute_value || !opportunityOption.model_attribute_value.value) return;\n    var opportunityId = opportunityOption.model_attribute_value.value;\n\n    if (!opportunityId) return;\n\n    // Filter options\n    var options = dropdown.options;\n    if (!options) return;\n\n    for (var i = 0; i &lt; options.length; i++) {\n        var option = options[i];\n        var text = option.textContent || option.innerText;\n\n        var match = text.match(/Opp:\\s*(\\d+)/);\n        \n        if (match &amp;&amp; match.length &gt; 1 &amp;&amp; opportunityId === match[1]) {\n            option.style.display = '';\n\n        } else {\n            option.style.display = 'none';\n        }\n    }\n}; filterApplicationDropdown(this);\" alt=\"\">"
