        {
          "config": {
            "allow_script": true,
            "strip_html": "0",
            "text": "{% assign pdc_preview = model.PDC_Data_Preview %}\n\n<div class=\"pdc-data-preview\">\n\n  <table class=\"pdc-fields-table\">\n    <thead>\n      <tr>\n        <th>Field Name</th>\n        <th>Value</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% if pdc_preview.error %}<tr class=\"no-value\"><td colspan=\"2\"><em>{{ pdc_preview.error | escape }}</em></td></tr>{% endif %}\n      {% for field in pdc_preview.display_fields %}\n      <tr class=\"{% unless field.has_value %}no-value{% endunless %}\">\n        <td>{{ field.field_name }}</td>\n        <td>\n          {% if field.has_value %}\n            {{ field.value }}\n          {% else %}\n            <em>No data</em>\n          {% endif %}\n        </td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <style>\n    .pdc-data-preview {\n      margin: 20px 0;\n    }\n    .pdc-fields-table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-top: 15px;\n    }\n    .pdc-fields-table th {\n      background-color: #f0f0f0;\n      padding: 10px;\n      text-align: left;\n      border-bottom: 2px solid #ddd;\n    }\n    .pdc-fields-table td {\n      padding: 8px;\n      border-bottom: 1px solid #eee;\n    }\n    .pdc-fields-table tbody tr:nth-child(even) {\n      background-color: #f8f8f8;\n    }\n    .pdc-fields-table tr.no-value td {\n      color: #999;\n    }\n    .summary {\n      background-color: #f9f9f9;\n      padding: 10px;\n      border-radius: 4px;\n      margin: 10px 0;\n    }\n  </style>\n</div>"
          },
